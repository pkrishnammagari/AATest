.venv/
__pycache__/
*.pyc

# Built by scripts/build_wheels.sh -- ~103 MB of binary wheels, rebuild rather
# than commit.
wheels/
wheels.tgz

# Generated by scripts/fetch_fonts.py. fonts_inline.css IS committed (the server
# has no internet and cannot regenerate it); the raw woff2 files are kept only
# for auditing and can be re-fetched.
assets/fonts/*.woff2

.DS_Store
node_modules/
aecb_api.log

# Live API captures written by app_api.py via aecb/archive.py -- real bureau
# data, never commit. The anonymized fixtures at ReferenceJSON/ top level ARE
# committed.
ReferenceJSON/api_responses/
